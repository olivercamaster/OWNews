{
  "expo": {
    "name": "OWBuddy",
    "slug": "owbuddy",
    "owner": "offshoreworks",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "owbuddy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061c2b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.ownews.owbuddy"
    },
    "android": {
      "package": "br.com.ownews.owbuddy",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#061c2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dd5c107-84cf-4e90-a05c-71697c9d9b2f"
      }
    }
  }
}
