{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownews-git",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "triggers": {
    "crons": [
      "50 8 * * *",
      "50 11 * * *",
      "50 14 * * *",
      "50 17 * * *",
      "50 20 * * *",
      "50 22 * * *"
    ]
  }
}
