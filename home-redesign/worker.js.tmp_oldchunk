function renderAeroportosAgora(){var el=document.getElementById("agoraAeroportos");if(!el)return;el.innerHTML=AEROPORTOS_ORDEM.map(function(a){var info=MAPA_AEROPORTOS[a.codigo]||{};var classe=info.status==="g"?"green":info.status==="y"?"yellow":info.status==="r"?"red":"unknown";var clima=info.clima||{};var mini;if(climaOk(clima)){var temp=typeof clima.temperatura==="number"?(" "+clima.temperatura+"°"):"";mini="<span class=\\"agora-clima\\">"+(clima.icone||"")+temp+"</span>";}else{mini="<span class=\\"agora-clima sem-dado\\">— Sem dados</span>";}return "<div class=\\"agora-airport\\"><span class=\\"agora-dot "+classe+"\\"></span><span class=\\"agora-code\\">"+a.codigo+"</span><span class=\\"agora-cidade\\">"+esc(a.nome)+"</span>"+mini+"</div>";}).join("");renderRadarAgora();}' +